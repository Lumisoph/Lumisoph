---
import type { CollectionEntry } from 'astro:content';
import { getI18n } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: string;
}

const { post, lang } = Astro.props;
const t = getI18n(lang);
const { title, description, date, tags, cover } = post.data;

const slug = post.id.replace(/^(zh|en)\//, '');
---

<article class="card-base overflow-hidden hover:-translate-y-1.5 flex flex-col group">
  {cover && (
    <img src={cover} alt={title} class="w-full h-48 object-cover" loading="lazy" />
  )}
  <div class="p-6 flex flex-col flex-1">
    <time class="text-xs text-[var(--color-text-muted)] mb-2 tracking-wide uppercase">
      {date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
    <h3 class="text-lg font-semibold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-primary)] transition-colors duration-300">{title}</h3>
    <p class="text-sm text-[var(--color-text-muted)] mb-4 line-clamp-3 flex-1 leading-relaxed">{description}</p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <a href={`${import.meta.env.BASE_URL}${lang}/blog/${slug}`}
       class="text-sm font-medium text-[var(--color-primary)] hover:underline underline-offset-4 transition-all duration-300">
      {t.blog.readMore} →
    </a>
  </div>
</article>
