---
interface SkillGroup {
  title: string;
  items: string[];
}

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<section class="py-16">
  <div class="max-w-3xl mx-auto px-4">
    <div class="space-y-8">
      {groups.map((group) => (
        <div>
          <h3 class="text-xs font-semibold text-[var(--color-text-muted)] mb-3 text-center md:text-left uppercase tracking-[0.2em]">
            {group.title}
          </h3>
          <div class="flex flex-wrap justify-center md:justify-start gap-2">
            {group.items.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
