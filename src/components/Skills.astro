---
interface SkillGroup {
  title: string;
  items: string[];
}

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<section class="py-16">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-10 text-[var(--color-text)]">
      技能
    </h2>
    <div class="space-y-8">
      {groups.map((group) => (
        <div>
          <h3 class="text-sm font-medium text-[var(--color-text-muted)] mb-3 text-center md:text-left">
            {group.title}
          </h3>
          <div class="flex flex-wrap justify-center md:justify-start gap-2">
            {group.items.map((item) => (
              <span class="px-4 py-2 rounded-btn text-sm font-medium
                           bg-[var(--color-card)] border border-[var(--color-card-border)]
                           text-[var(--color-text)] shadow-sm
                           hover:border-[var(--color-primary)] transition-colors duration-300">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
